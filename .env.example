# Стенограф configuration — copy to .env and adjust.

# Where job data, uploads and the database live.
MEETSCRIBE_DATA_DIR=./data

# Root folder with pre-downloaded models (LM-Studio-like layout).
# Whisper models are looked up as <MODELS_DIR>/Systran/faster-whisper-<name>/;
# otherwise the model id (e.g. large-v3) is downloaded from Hugging Face.
#MEETSCRIBE_MODELS_DIR=D:/models

# ffmpeg/ffprobe binaries: command name (PATH lookup) or absolute path.
#MEETSCRIBE_FFMPEG=ffmpeg
#MEETSCRIBE_FFPROBE=ffprobe

# Whisper defaults.
#MEETSCRIBE_DEVICE=cuda
#MEETSCRIBE_COMPUTE_TYPE=float16
#MEETSCRIBE_WHISPER_MODEL=large-v3
#MEETSCRIBE_LANGUAGE=auto

# Live mode (browser/WASAPI capture + local-agreement streaming on whisper).
#MEETSCRIBE_LIVE_MODEL=large-v3-turbo
#MEETSCRIBE_LIVE_STEP_SEC=0.8
# After a live session stops, re-transcribe the recording with the default
# engine (moss) to improve it; false disables the automatic pass (the manual
# button on the job page stays available).
#MEETSCRIBE_LIVE_AUTO_REPROCESS=true
# Decode Live/Jitsi audio while it is being recorded. false (the default) =
# record-only: sessions only save the audio, and the quality pass (auto or
# manual) transcribes it afterwards through the shared queue, like files.
#MEETSCRIBE_REALTIME_TRANSCRIBE=false
# Jitsi meetings: finalize automatically after this many seconds without any
# speech (0 disables). Covers abandoned rooms — Jigasi only disconnects when
# the last participant leaves, so one forgotten client can keep a recording
# alive indefinitely.
#MEETSCRIBE_JITSI_IDLE_STOP_SEC=600
# Restart recovery: the queue lives in memory, so a fresh process finds jobs
# left queued/running by the previous shutdown. true (default) = bring them
# back: waiting jobs return to the queue as-is, interrupted ones restart from
# scratch in the same job; recordings (live/jitsi) can only be marked
# "interrupted by a server stop". false = only mark orphans, nothing restarts.
#MEETSCRIBE_RESTART_RECOVER=true
# Live transcription queue: one decode worker serves all sessions turn by
# turn; these bound the GPU work one session may take per turn.
#MEETSCRIBE_LIVE_TURN_TICKS=6
#MEETSCRIBE_LIVE_TURN_SEC=2.0

# Default ASR engine: whisper (faster-whisper) or moss (end-to-end + diarization).
#MEETSCRIBE_ENGINE=whisper

# MOSS tuning (engine=moss only).
#MEETSCRIBE_MOSS_CHUNK_SEC=300
#MEETSCRIBE_MOSS_CHUNK_OVERLAP_SEC=2
#MEETSCRIBE_MOSS_MAX_NEW_TOKENS=4096

# LLM post-processing (protocol / summary) via an OpenAI-compatible server.
# LM Studio: run the server, model name from the "Developer" tab.
#MEETSCRIBE_LLM_BASE_URL=http://127.0.0.1:1234/v1
#MEETSCRIBE_LLM_MODEL=gemma-3-4b-it
#MEETSCRIBE_LLM_API_KEY=
#MEETSCRIBE_LLM_TIMEOUT_SEC=600
#MEETSCRIBE_LLM_MAX_TOKENS=4096
# Transcript chunk size (chars) for map-reduce on long recordings.
#MEETSCRIBE_LLM_CHUNK_CHARS=9000

# HTTP server.
#MEETSCRIBE_HOST=127.0.0.1
#MEETSCRIBE_PORT=8000
#MEETSCRIBE_LOG_LEVEL=INFO

# Hugging Face token (needed later for gated models such as pyannote).
#HF_TOKEN=
