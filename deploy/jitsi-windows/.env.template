# ============================================================================
#  Stenograph Jitsi on Windows - environment template.
#  start.bat copies this file to .env on the first run and fills in the
#  HOST_IP and PW_* placeholders (machine LAN address + random passwords).
#  The .env file is NEVER committed: it is machine-local and holds secrets.
# ============================================================================

# --- Core -------------------------------------------------------------------
CONFIG=./config
HTTP_PORT=8081
HTTPS_PORT=8443
TZ=Europe/Moscow
PUBLIC_URL=https://{{HOST_IP}}:8443
ENABLE_LETSENCRYPT=0
DOCKER_HOST_ADDRESS={{HOST_IP}}

# --- Transcription (jigasi -> Stenograph server on this same PC) ------------
ENABLE_TRANSCRIPTIONS=1
TRANSCRIPTION_CUSTOM_LANGUAGES={"ru":"Русский","en":"English"}
JIGASI_TRANSCRIBER_CUSTOM_SERVICE=org.jitsi.jigasi.transcription.WhisperTranscriptionService
# Сервер транскрибации по HTTPS :443 (нативный TLS, без прокси).
# Для сервера без TLS используйте: ws://host.docker.internal:8000/ws
JIGASI_TRANSCRIBER_WHISPER_URL=wss://host.docker.internal/ws
PREFERRED_LANGUAGE=ru-RU
USE_APP_LANGUAGE=0
TRANSLATION_LANGUAGES=["ru"]

# --- Participant audio: no client-side "enhancements" (raw audio for ASR) ---
ENABLE_AUDIO_PROCESSING=0
ENABLE_AUTOMATIC_GAIN_CONTROL=0

# --- Passwords (generated by start.bat; do not reuse anywhere else) ---------
JICOFO_AUTH_PASSWORD={{PW_JICOFO}}
JVB_AUTH_PASSWORD={{PW_JVB}}
JIGASI_XMPP_PASSWORD={{PW_JIGASI_XMPP}}
JIGASI_TRANSCRIBER_PASSWORD={{PW_JIGASI_TRANSCRIBER}}
JIBRI_XMPP_PASSWORD={{PW_JIBRI_XMPP}}
JIBRI_RECORDER_PASSWORD={{PW_JIBRI_RECORDER}}
